# Sustituye ambas contraseñas por cadenas aleatorias antes de desplegar.
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=cambiar-por-una-clave-aleatoria-de-administrador
MONGO_APP_USER=autoescuela_app
MONGO_APP_PASSWORD=cambiar-por-una-clave-aleatoria-de-aplicacion
MONGO_DB_NAME=autoescuela

# Puerto publicado para la web.
HOST_PORT=3000

# Mongo escucha solo en localhost de la VM; acceso remoto opcional por túnel SSH.
MONGO_HOST_PORT=27017
